# ============================================================
# docker compose 运行参数模板：cp .env.example .env
# 不提供 .env 时，docker-compose.yml 也会用下面这套默认值。
# ============================================================

# MySQL root 密码（后端用同一账号连库）
MYSQL_ROOT_PASSWORD=GXNNante2026

# 数据库名
DB_NAME=erp

# Web 对外端口：http://<服务器IP>:8989
WEB_PORT=8989

# 生产密钥：务必替换成随机字符串（可用 openssl rand -hex 48 生成）
JWT_SECRET=replace-with-random-string
APP_KEYS=replace-with-random-string
