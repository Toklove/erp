{
  "name": "erp-server",
  "version": "0.1.0",
  "description": "仓库 ERP 服务端（Midway 4 + TypeORM + MySQL）",
  "private": true,
  "dependencies": {
    "@midwayjs/bootstrap": "^4.2.6",
    "@midwayjs/core": "^4.2.6",
    "@midwayjs/cron": "^4.2.6",
    "@midwayjs/info": "^4.2.6",
    "@midwayjs/jwt": "^4.2.6",
    "@midwayjs/koa": "^4.2.6",
    "@midwayjs/logger": "^4.1.0",
    "@midwayjs/typeorm": "^4.2.6",
    "@midwayjs/validation": "^4.2.6",
    "@midwayjs/validation-joi": "^4.2.6",
    "decimal.js": "^10.6.0",
    "joi": "^17.13.3",
    "mysql2": "^3.24.6",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@midwayjs/mock": "^4.2.6",
    "@types/jest": "^29.2.0",
    "@types/node": "20",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mwts": "^2.0.4",
    "mwtsc": "^1.4.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "dev": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env NODE_ENV=unittest jest",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "build": "mwtsc --cleanOutDir"
  },
  "license": "MIT"
}
